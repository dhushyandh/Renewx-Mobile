{
  "expo": {
    "name": "RenewX Crew",
    "slug": "renewx-crew-2",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "renewx",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow RenewX to use your location to set your delivery area."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "name": "RenewX Crew",
      "shortName": "RenewX",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.renewx.crew"
    },
    "ios": {
      "bundleIdentifier": "com.renewx.crew"
    }
  }
}
